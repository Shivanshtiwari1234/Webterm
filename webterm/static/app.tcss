Screen {
    layout: vertical;
    width: 100%;
    height: 100%;
}

Header {
    height: 1;
    dock: top;
}

Footer {
    height: 1;
    dock: bottom;
}

#toolbar {
    width: 100%;
    height: 3;
    min-height: 3;
    padding: 0 1;
    background: $surface;
    align: left middle;
}

#toolbar Button {
    width: 9;
    min-width: 9;
    max-width: 9;
    height: 3;
    margin: 0;
    padding: 0 1;
}

#url {
    width: 1fr;
    min-width: 1;
    height: 3;
    margin: 0 1;
}

#tabbar {
    width: 100%;
    height: 3;
    min-height: 3;
    padding: 0 1;
    background: $surface;
    align: left middle;
}

#tabbar Button {
    width: auto;
    min-width: 8;
    max-width: 22;
    height: 3;
    margin: 0 1 0 0;
    padding: 0 1;
}

#page {
    width: 1fr;
    height: 1fr;
    min-width: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: round $primary;
    background: #101114;
    overflow-y: auto;
    overflow-x: hidden;
}

#page-text {
    width: 1fr;
    height: auto;
    min-width: 1;
    min-height: 1;
    padding: 0 1;
    overflow: hidden;
}

#forms {
    width: 100%;
    height: auto;
    overflow: hidden;
    padding: 0 1;
}

.form-panel {
    width: 100%;
    height: auto;
    margin: 1 0;
    padding: 1;
    border: round $secondary;
}

.form-label {
    width: 100%;
    height: auto;
    margin: 0;
}

.form-control {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
}

.form-buttons {
    width: 100%;
    height: 3;
}

.form-buttons Button {
    width: auto;
    min-width: 8;
    height: 3;
    margin: 0 1 0 0;
    padding: 0 1;
}

#status {
    width: 100%;
    height: 1;
    padding: 0 1;
}
